# --- large / generated assets (never push these) ---
*.wav
*.flac
*.mp3
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.safetensors

# --- data ---
data/raw/*
data/cache/*
data/models/*
!data/**/.gitkeep
data/manifests/*.csv
data/manifests_full/
data/metadata/*.csv
# per-clip nuisance features behind the leakage audit (ProjectReport/technical-reference.md §3, report chapter 3)
!data/metadata/nuisance_features.csv
!data/manifests/SHA256SUMS

# --- experiment artifacts ---
# saved model bundles served by the app
artifacts/**
!artifacts/*/
# one dev threshold per system, replaced by every evaluation (helpers/artifacts.py)
!artifacts/*/threshold.json
