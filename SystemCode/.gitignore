checkpoints/
wandb/
reports/figures/*
!reports/**/.gitkeep

# --- python / uv ---
.venv/
# JEV key saved from the web app (backend/app.py)
.secrets/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- notebooks ---
.ipynb_checkpoints/
# executed copies from scripts/run_notebooks.py
notebooks/_executed/

# --- runs ---
# Run outputs stay local; only the layout README, the run log and whitelisted runs are tracked.
# Whitelist a run only when a tracked notebook, script or threshold.json reads it. Removing files
# later does not shrink the repo (git keeps history), so keep new runs small: big per-clip score
# files (2021 DF / 2021 LA eval) stay local unless something reads them; metrics*.json and
# calibration.json carry the reported numbers.
runs/*
!runs/README.md
!runs/REGISTRY.md
# exception: runs the tracked notebooks read
# first run (E1, raw training) and its trimmed re-scoring: notebook 02's silence section
!runs/E-20261001-e1-a1-raw/
!runs/E-20261001-e1-a1-trimmed/
!runs/E-20261001-e1-a2-raw/
!runs/E-20261001-e1-a2-trimmed/
runs/E-20261001-e1-*/score_jobs/
