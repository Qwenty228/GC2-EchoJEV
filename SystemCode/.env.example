# EchoJEV backend (run from SystemCode/)
# Available: a1, a2, a4, d1, d3
ADF_SYSTEM=a1

# Optional: omit to load latest completed artifact for ADF_SYSTEM.
# ADF_MODEL_FROM=artifacts/a1/20261020-000000-000000

# Optional: development-calibrated threshold for this exact artifact.
# Higher score means bona fide. Without this, verdict is null.
# ADF_THRESHOLD=0.6851713427401016

# Future A3/P1 JEV integration (not currently used by backend)
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
